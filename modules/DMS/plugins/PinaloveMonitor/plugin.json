{
    "id": "pinaloveMonitor",
    "name": "Pinalove Monitor",
    "description": "Notifies when a specified user comes online on pinalove.com",
    "version": "1.1.0",
    "author": "lessuseless",
    "type": "composite",
    "capabilities": ["daemon", "monitoring", "dankbar-widget"],
    "components": {
        "daemon": "./Daemon.qml",
        "widget": "./Widget.qml"
    },
    "settings": "./Settings.qml",
    "startupCheck": "./StartupCheck.qml",
    "icon": "notifications_active",
    "dependencies": ["curl"],
    "permissions": ["settings_read", "settings_write", "process", "network"]
}
